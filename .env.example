# Official production environment template.
# Copy this file to .env.production or .env.local when deploying.
# Vite exposes variables prefixed with VITE_.

## Base URL of the Test GSM API.
VITE_API_TEST_GSM_BASE=http://localhost:5001

## Base URL of the DATA API.
VITE_API_DATA_BASE=http://192.168.1.104:10000

## Base URL of the Manufacturing Order API.
VITE_API_MO_BASE=http://192.168.1.104:10000

## Base URL of the Print API.
VITE_API_PRINT_BASE=http://192.168.1.104:7001

## Product traceability status UIDs.
VITE_PRODUCT_STATUS_OK_UID=OK
VITE_PRODUCT_STATUS_KO_UID=NOK

## Machine UID reported in traceability payloads.
VITE_MACHINE_UID=MO03A
