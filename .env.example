# Copy this file to .env.local and adjust as needed
# Vite exposes variables prefixed with VITE_

## Base URL of the Test GSM API
## In development, you can leave this empty and use the Vite proxy (see vite.config.js).
## If you prefer to bypass the proxy, set it explicitly, e.g. http://localhost:5001
# VITE_API_TEST_GSM_BASE=http://localhost:5001

# Base URL of the DATA API
# VITE_API_DATA_BASE=http://localhost:5002
