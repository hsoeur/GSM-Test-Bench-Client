API_PRINT_BASE=http://192.168.1.104:7001

PRODUCT_STATUS_OK_UID=OK
PRODUCT_STATUS_KO_UID=NOK
MACHINE_UID=MO03A

API_STATUS_POLL_INTERVAL_MS=10000
API_STATUS_TIMEOUT_MS=4000
